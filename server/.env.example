# =========================================================================
# SIGNALFORM Bespoke Brief Server - Environment Configurations
# =========================================================================
# Copy this file to a new file named '.env' in this directory and populate
# your active API keys.
# =========================================================================

# Port for the local server
PORT=4000

# OpenAI API Key (Required for vector embedding semantic-memory retrieval)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API Key (Optional - falls back to OpenAI or Gemini if set)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API Key (Optional - falls back to OpenAI or Anthropic if set)
GEMINI_API_KEY=your_gemini_api_key_here
